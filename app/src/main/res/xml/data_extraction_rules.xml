<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup/transfer rules. Same rationale as backup_rules.xml (used for API < 31):
   the vault database, saved photos, and manual export files are excluded from both cloud backup
   and direct device-to-device transfer, so App Lock can't be silently bypassed by restoring onto
   a different device. The in-app Backup & Data export feature remains the explicit, user-driven
   way to move vault data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="spotvault_database" />
        <exclude domain="database" path="spotvault_database-wal" />
        <exclude domain="database" path="spotvault_database-shm" />
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="sharedpref" path="SpotVaultPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="spotvault_database" />
        <exclude domain="database" path="spotvault_database-wal" />
        <exclude domain="database" path="spotvault_database-shm" />
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="sharedpref" path="SpotVaultPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
