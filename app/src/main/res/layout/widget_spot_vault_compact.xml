<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="8dp"
    android:gravity="center_vertical">
    
    <TextView
        android:id="@+id/widget_found_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_purple"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:text="Found"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
        
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        
        <Chronometer
            android:id="@+id/widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ECE6F5" />
            
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Pin"
            android:textSize="12sp"
            android:textColor="#A89BB8" />
            
    </LinearLayout>

    <TextView
        android:id="@+id/widget_silence_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_danger"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:text="Silence"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_nav_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_teal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center"
        android:text="Nav"
        android:textSize="13sp"
        android:textColor="#150030"
        android:textStyle="bold" />
        
</LinearLayout>
